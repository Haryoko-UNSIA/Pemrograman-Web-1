/* css/pages.css — Vitabyte Page Specific Layout Overrides & Decorators */

/* HERO SECTION DECORATION */
.hero-image-wrapper {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.12);
}

.hero-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* VitaGrow Landing Hero Carousel */
.vitagrow-hero {
  display: grid;
  grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
  gap: 2rem;
  align-items: center;
  min-height: 500px;
  padding: clamp(1.25rem, 3vw, 2.5rem);
  border-radius: 30px;
  background: linear-gradient(135deg, #f7fbf8 0%, #ffffff 52%, #f4fbf6 100%);
  border: 1px solid rgba(16, 185, 129, .12);
  box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
  overflow: hidden;
}
.vitagrow-hero-title span { color: #15803d; }
.vitagrow-hero-description { max-width: 620px; line-height: 1.7; }
.vitagrow-hero-trust { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; color: #64748b; font-size: .88rem; }
.vitagrow-carousel { min-width: 0; }
.vitagrow-slide-frame { position: relative; min-height: 430px; border-radius: 26px; overflow: hidden; background: #eef7f1; box-shadow: inset 0 0 0 1px rgba(255,255,255,.65); }
.vitagrow-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transform: scale(1.025); transition: opacity .65s ease, transform .8s ease, visibility .65s ease; }
.vitagrow-slide.is-active { opacity: 1; visibility: visible; transform: scale(1); }
.vitagrow-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.vitagrow-slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,23,42,0) 48%, rgba(15,23,42,.18) 100%); pointer-events: none; }
.vitagrow-slide-caption { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; z-index: 2; max-width: 360px; padding: 1rem 1.1rem; border-radius: 18px; background: rgba(255,255,255,.9); backdrop-filter: blur(10px); box-shadow: 0 12px 30px rgba(15,23,42,.12); }
.vitagrow-slide-caption strong, .vitagrow-slide-caption small { display: block; }
.vitagrow-slide-caption strong { font-size: 1.02rem; margin: .18rem 0 .2rem; color: #0f172a; }
.vitagrow-slide-caption small { color: #475569; line-height: 1.45; }
.vitagrow-slide-kicker { font-weight: 800; font-size: .82rem; text-transform: uppercase; letter-spacing: .06em; }
.vitagrow-tone-blue .vitagrow-slide-kicker { color: #0284c7; }
.vitagrow-tone-purple .vitagrow-slide-kicker { color: #6d28d9; }
.vitagrow-tone-orange .vitagrow-slide-kicker { color: #c2410c; }
.vitagrow-tone-green .vitagrow-slide-kicker { color: #15803d; }
.vitagrow-carousel-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 4; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgba(255,255,255,.92); color: #0f172a; font-size: 1.7rem; line-height: 1; box-shadow: 0 8px 24px rgba(15,23,42,.14); transition: transform .2s ease, background .2s ease; }
.vitagrow-carousel-arrow:hover { transform: translateY(-50%) scale(1.06); background: #fff; }
.vitagrow-carousel-arrow.prev { left: .85rem; }
.vitagrow-carousel-arrow.next { right: .85rem; }
.vitagrow-carousel-dots { display: flex; justify-content: center; gap: .55rem; margin-top: .9rem; }
.vitagrow-carousel-dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: #cbd5e1; transition: all .25s ease; }
.vitagrow-carousel-dots button.is-active { width: 26px; border-radius: 999px; background: #16a34a; }
@media (max-width: 991.98px) {
  .vitagrow-hero { grid-template-columns: 1fr; padding: 1.25rem; }
  .vitagrow-slide-frame { min-height: 390px; }
}
@media (max-width: 575.98px) {
  .vitagrow-hero { border-radius: 22px; }
  .vitagrow-slide-frame { min-height: 330px; border-radius: 20px; }
  .vitagrow-hero-trust { display: none; }
  .vitagrow-slide-caption { left: .8rem; right: .8rem; bottom: .8rem; padding: .8rem .9rem; }
  .vitagrow-carousel-arrow { width: 36px; height: 36px; font-size: 1.4rem; }
}

/* v1.5 Revisi 9 — clean landing page based on approved reference */
.vitagrow-hero-simple {
  display: grid;
  grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
  gap: 2rem;
  align-items: center;
  min-height: 560px;
  padding: clamp(1.4rem, 3vw, 2.5rem);
  border-radius: 30px;
  background: linear-gradient(135deg, #ffffff 0%, #fbfefc 58%, #f3faf6 100%);
  border: 1px solid rgba(16, 185, 129, .10);
  box-shadow: 0 20px 52px rgba(15, 23, 42, .055);
  overflow: hidden;
}
.vitagrow-hero-simple-copy { min-width: 0; padding-left: clamp(.2rem, 1vw, 1rem); }
.vitagrow-hero-simple-copy .vitagrow-hero-title { font-size: clamp(2.8rem, 5vw, 4.55rem); line-height: 1.05; letter-spacing: -.035em; }
.vitagrow-hero-simple-copy .vitagrow-hero-description { max-width: 590px; line-height: 1.7; }
.vitagrow-hero-link { color: #087f4f; font-weight: 700; text-decoration: none; padding: .75rem .25rem; }
.vitagrow-hero-link:hover { color: #05633e; text-decoration: underline; }
.vitagrow-hero-trust { display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; color: #334155; font-size: .88rem; }
.vitagrow-hero-trust span { display: block; line-height: 1.45; }
.vitagrow-hero-trust small { color: #64748b; }
.vitagrow-hero-simple-visual { position: relative; min-height: 500px; display: flex; align-items: center; justify-content: center; padding: .25rem; }
.vitagrow-hero-simple-visual::before { content: ''; position: absolute; width: 94%; aspect-ratio: 1.15; border-radius: 50%; background: radial-gradient(circle, rgba(22,163,74,.10), rgba(255,255,255,0) 68%); }
.vitagrow-hero-simple-visual img { position: relative; width: min(100%, 650px); max-height: 520px; object-fit: contain; display: block; filter: saturate(1.02); }
.vitagrow-hero-note { color: #64748b; font-size: .9rem; }
.vitagrow-pillars-section { scroll-margin-top: 90px; }
.vitagrow-pillar-card { overflow: hidden; border: 1px solid #dbe5e1; border-radius: 22px; background: #fff; box-shadow: 0 10px 28px rgba(15,23,42,.06); transition: transform .2s ease, box-shadow .2s ease; }
.vitagrow-pillar-card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px rgba(15,23,42,.09); }
.vitagrow-pillar-image-wrap { position: relative; height: 180px; overflow: hidden; background: #f5faf7; }
.vitagrow-pillar-image-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
.vitagrow-pillar-number { position: absolute; top: 14px; left: 14px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; color: #fff; font-weight: 800; background: #15803d; box-shadow: 0 5px 12px rgba(15,23,42,.14); }
.vitagrow-pillar-blue .vitagrow-pillar-number { background: #1677c8; }
.vitagrow-pillar-purple .vitagrow-pillar-number { background: #5b4bb7; }
.vitagrow-pillar-green .vitagrow-pillar-number { background: #34844a; }
.vitagrow-pillar-orange .vitagrow-pillar-number { background: #d97706; }
.vitagrow-pillar-title { display: flex; align-items: center; gap: .55rem; font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: .6rem; }
.vitagrow-pillar-title span { font-size: 1.15rem; }
.vitagrow-pillar-link { color: #087f4f; font-weight: 700; text-decoration: none; }
.vitagrow-pillar-link:hover { text-decoration: underline; }
@media (max-width: 991.98px) {
  .vitagrow-hero-simple { grid-template-columns: 1fr; min-height: auto; }
  .vitagrow-hero-simple-visual { min-height: 360px; order: -1; }
  .vitagrow-hero-simple-copy { padding-left: 0; }
}
@media (max-width: 575.98px) {
  .vitagrow-hero-simple { border-radius: 22px; padding: 1.1rem; }
  .vitagrow-hero-simple-copy .vitagrow-hero-title { font-size: 2.5rem; }
  .vitagrow-hero-simple-visual { min-height: 280px; }
  .vitagrow-pillar-image-wrap { height: 175px; }
  .vitagrow-hero-note { font-size: .82rem; }
}
